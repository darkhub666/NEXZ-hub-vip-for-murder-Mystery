-- ===== helpers =====
local function getRole(plr: Player): string?
	local char, bp = plr.Character, plr:FindFirstChildOfClass("Backpack")
	if (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return "murder" end
	if (char and char:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return "sheriff" end
	return nil
end

local function findPlayerByRole(role: string): Player?
	for _, p in ipairs(Players:GetPlayers()) do
		if getRole(p) == role then return p end
	end
	return nil
end

local function getGunDrop(): BasePart?
	local d = Workspace:FindFirstChild("GunDrop", true)
	if d and d:IsA("BasePart") then return d end
	return nil
end

local function root(plr: Player): BasePart?
	return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
end

-- ===== ESP =====
local function setHighlight(plr: Player, color: Color3?)
	local h = highlights[plr]
	if not color or not plr.Character then
		if h then h:Destroy() highlights[plr] = nil end
		return
	end
	if not h or h.Parent ~= plr.Character then
		if h then h:Destroy() end
		h = Instance.new("Highlight")
		h.FillTransparency = 0.5
		h.OutlineColor = Color3.new(1, 1, 1)
		h.Parent = plr.Character
		highlights[plr] = h
	end
	h.FillColor = color
end

local roleLabel
local function updateESP()
	local m, s = findPlayerByRole("murder"), findPlayerByRole("sheriff")
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if state.esp and p == m then setHighlight(p, Color3.fromRGB(255, 40, 40))
			elseif state.esp and p == s then setHighlight(p, Color3.fromRGB(60, 120, 255))
			else setHighlight(p, nil) end
		end
	end
	if roleLabel then
		roleLabel.Text = "Murder: " .. (m and m.DisplayName or "?") .. "\nSheriff: " .. (s and s.DisplayName or "?")
	end
end

-- ===== auto gun + auto kill =====
local busy = false
local function grabGun()
	if busy then return end
	local drop, r = getGunDrop(), LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not drop or not r then return end
	busy = true
	local back = r.CFrame
	r.CFrame = drop.CFrame + Vector3.new(0, 2, 0)
	task.wait(0.15)
	if firetouchinterest then
		pcall(function() firetouchinterest(r, drop, 0) firetouchinterest(r, drop, 1) end)
	end
	task.wait(0.25)
	if not state.autoKill then r.CFrame = back end
	busy = false
end

local lastShot = 0
local function killMurder()
	local char = LP.Character
	local bp = LP:FindFirstChildOfClass("Backpack")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum) then return end
	local gun = char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
	if not gun then return end
	local m = findPlayerByRole("murder")
	local mr = m and root(m)
	local r = char:FindFirstChild("HumanoidRootPart")
	if not (mr and r) then return end
	if gun.Parent ~= char then hum:EquipTool(gun) task.wait(0.1) end
	if tick() - lastShot < 1 then return end
	lastShot = tick()
	r.CFrame = mr.CFrame * CFrame.new(0, 0, 6)
	task.wait(0.05)
	local ok = pcall(function()
		gun.KnifeLocal.CreateBeam.RemoteFunction:InvokeServer(1, mr.Position, "AH2")
	end)
	if not ok then pcall(function() gun:Activate() end) end
end

task.spawn(function()
	while task.wait(0.3) do
		if not gui or not gui.Parent then break end
		pcall(updateESP)
		if state.autoGun and getGunDrop() then pcall(grabGun) end
		if state.autoKill then pcall(killMurder) end
	end
end)

